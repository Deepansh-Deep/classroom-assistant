# Required in production; any random 32+ character string. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# development | production
ENV=development
# SQLite by default. For Postgres: postgresql+psycopg://user:pass@localhost:5432/classroom
# DATABASE_URL=
DEMO_MODE=true

# Optional: real Google Classroom sign-in (console.cloud.google.com > Credentials > OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:8000

# Optional: lets an LLM phrase Q&A answers (still restricted to cited course sources)
GROQ_API_KEY=
